[Unit]
Description=windbreak pipeline process (SPEC Process A)
After=network.target
# Retry forever. With the default limit (5 starts / 10s) a fast-failing
# process is abandoned in `failed` -- silent, on the one deployment whose
# entire purpose is running unattended (issue #446).
StartLimitIntervalSec=0

[Service]
# The unit runs out of an installed copy of this repository, so the fixture
# paths below are repo-relative -- identical to the invocation in
# docs/RUNBOOK.md. systemd's default working directory is `/`, so this line is
# what makes them resolve.
WorkingDirectory=/opt/windbreak
# Create the state directories the flags below write into. Nothing else does:
# `--ledger-path`'s parent directory must already exist (docs/RUNBOOK.md) --
# the `.db` and its `-wal` sibling are created on first use, the directory is
# not -- so without this line `SqliteLedgerStore.__init__` raises
# `sqlite3.OperationalError: unable to open database file` on the very first
# config load. Combined with `Restart=on-failure` and the removed start rate
# limit above, that is not a unit that lands in `failed`; it is one that
# retries forever writing nothing, which is exactly issue #446's defect.
#
# `StateDirectory=` rather than `ExecStartPre=/bin/mkdir`: systemd creates each
# name under /var/lib itself, before ExecStart, and re-asserts ownership on
# every start -- handing the directories to whatever `User=` the unit declares.
# This unit declares none (so they are root-owned, as the process is), but an
# operator who adds one needs no second `chown`. It also avoids hardcoding an
# absolute `mkdir` path, which is the install-prefix fragility the
# `/usr/bin/env` shim below exists to avoid.
#
# The two names mirror the Dockerfile's `mkdir -p` for the compose skeleton, so
# both shipped deployments provision the same two directories.
StateDirectory=windbreak/ledger windbreak/reports
# All four PAPER composition flags, or `_resolve_on_beat` returns None and this
# is a bare RESEARCH heartbeat that writes no ledger (issue #446).
ExecStart=/usr/bin/env windbreak run --process pipeline --paper-books-dir tests/fixtures/books/deep_walk --cassette-path tests/fixtures/forecast/cassettes.json --ledger-path /var/lib/windbreak/ledger/windbreak.db --report-dir /var/lib/windbreak/reports
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
